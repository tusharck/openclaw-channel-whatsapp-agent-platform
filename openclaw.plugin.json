{
  "id": "whatsapp-agent-platform",
  "name": "WhatsApp Agent Platform",
  "version": "0.1.1",
  "description": "Connect OpenClaw to a WhatsApp third-party agent through WhatsApp's official Agent Platform API (long-poll ingress, no webhooks, no unofficial libraries).",
  "categories": [
    "channels"
  ],
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "string",
        "minLength": 1
      },
      "enabled": {
        "default": true,
        "type": "boolean"
      },
      "pollTimeout": {
        "default": 15,
        "type": "integer",
        "minimum": 0,
        "maximum": 25
      },
      "pollLimit": {
        "default": 50,
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "sessionKeyPrefix": {
        "default": "whatsapp-agent",
        "type": "string",
        "minLength": 1
      },
      "sendReadReceipts": {
        "default": true,
        "type": "boolean"
      },
      "mediaDir": {
        "type": "string"
      },
      "chunkLimit": {
        "default": 4000,
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      },
      "previewUrl": {
        "default": false,
        "type": "boolean"
      },
      "creatorId": {
        "type": "string"
      },
      "baseUrl": {
        "default": "https://api.whatsapp.com/agent/v1",
        "type": "string",
        "format": "uri"
      },
      "accounts": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
