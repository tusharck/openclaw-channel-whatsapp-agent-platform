{
  "name": "whatsapp-agent-platform",
  "version": "0.1.0",
  "description": "OpenClaw channel plugin for WhatsApp's official Agent Platform API (third-party agents).",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "files": [
    "dist",
    "README.md",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "plugin:build": "npm run build && node scripts/generate-manifest.mjs",
    "plugin:validate": "openclaw plugins validate"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "openclaw": ">=2026.9.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "compat": {
      "pluginApi": "2026.9"
    },
    "build": {
      "openclawVersion": "2026.9.4"
    },
    "channel": {
      "id": "whatsapp-agent-platform",
      "label": "WhatsApp Agent Platform",
      "blurb": "Connect OpenClaw to a WhatsApp third-party agent via the official Agent Platform API."
    }
  }
}
